<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GmailWatcher.Desktop.ViewModels"
        x:Class="GmailWatcher.Desktop.Views.ConfirmWindow"
        x:DataType="vm:ConfirmViewModel"
        Title="{Binding Title}"
        Width="480" SizeToContent="Height" MinWidth="360"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <StackPanel Margin="24,20,24,20" Spacing="12">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <PathIcon Data="{StaticResource IconWarning}" Width="20" Height="20" IsVisible="{Binding IsDangerous}" Foreground="{DynamicResource StatusFailureBrush}" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <StackPanel IsVisible="{Binding NeedsPhrase}" Spacing="4">
      <TextBlock Text="{Binding PhrasePrompt}" FontWeight="SemiBold" />
      <TextBox Name="PhraseBox" Text="{Binding TypedPhrase}" AutomationProperties.Name="Confirmation phrase" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" Click="OnCancelClick" IsDefault="{Binding CancelIsDefault}" IsVisible="{Binding ShowCancel}" />
      <Button Content="{Binding ConfirmText}" Click="OnConfirmClick" IsEnabled="{Binding CanConfirm}" Classes="accent" Classes.danger="{Binding IsDangerous}" IsDefault="{Binding InfoOnly}" />
    </StackPanel>
  </StackPanel>
</Window>
