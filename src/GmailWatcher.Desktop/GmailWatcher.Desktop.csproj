<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>GmailWatcher</AssemblyName>
    <RootNamespace>GmailWatcher.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\GmailWatcher.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Release RID (scripts/publish-windows.ps1); listed so restore and packages.lock.json match the release publish. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GmailWatcher.Core\GmailWatcher.Core.csproj" />
    <ProjectReference Include="..\GmailWatcher.Google\GmailWatcher.Google.csproj" />
    <ProjectReference Include="..\GmailWatcher.Archive\GmailWatcher.Archive.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets\GmailWatcher.ico" />
    <AvaloniaResource Include="Assets\GmailWatcher-busy.ico" />
    <AvaloniaResource Include="Assets\GmailWatcher-attention.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GmailWatcher.Desktop.Tests" />
  </ItemGroup>
</Project>
